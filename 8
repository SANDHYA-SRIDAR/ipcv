import cv2
import numpy as np
import matplotlib.pyplot as plt

img = cv2.imread("selfie.jpg")
if img is None:
    raise FileNotFoundError("Image not found")

img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
gammas = [0.2, 0.4, 0.6, 1.0, 1.5, 2.0, 3.0]

plt.figure(figsize=(14, 7))
plt.subplot(2, 4, 1)
plt.imshow(img)
plt.title("Original")
plt.axis("off")

for i, g in enumerate(gammas):
    result = (255 * (img / 255.0) ** g).astype(np.uint8)
    plt.subplot(2, 4, i+2)
    plt.imshow(result)
    plt.title(f"Gamma={g}")
    plt.axis("off")

plt.tight_layout()
plt.show()