import cv2
import numpy as np
import matplotlib.pyplot as plt

img = cv2.imread("selfie.jpg")
if img is None:
    raise FileNotFoundError("Image not found")

img = img.astype(np.float32)
noise = np.random.normal(110, 5, img.shape)
noisy = np.clip(img + noise, 0, 255).astype(np.uint8)

kernel = np.ones((5, 5), np.float32) / 25
recovered = cv2.filter2D(noisy, -1, kernel)

mse = np.mean((img - recovered.astype(np.float32)) ** 2)
print("MSE:", mse)

images = [img.astype(np.uint8), noisy, recovered]
titles = ["Original", "Noisy", "Recovered"]

for i in range(3):
    plt.subplot(1, 3, i+1)
    plt.imshow(cv2.cvtColor(images[i], cv2.COLOR_BGR2RGB))
    plt.title(titles[i])
    plt.axis("off")

plt.show()