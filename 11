import cv2
import numpy as np
import matplotlib.pyplot as plt

img = cv2.imread("selfie.jpg")
if img is None:
    raise FileNotFoundError("Image not found")

img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
h, w = img.shape[:2]
y, x = np.indices((h, w))
coords = np.array([x.ravel()-w/2, y.ravel()-h/2])

def transform(M):
    src = np.linalg.inv(M) @ coords
    sx = np.rint(src[0]+w/2).astype(int)
    sy = np.rint(src[1]+h/2).astype(int)
    out = np.zeros_like(img)
    valid = (sx>=0)&(sx<w)&(sy>=0)&(sy<h)
    out.reshape(-1, 3)[valid] = img[sy[valid], sx[valid]]
    return out

t = np.radians(30)
R = np.array([[np.cos(t), -np.sin(t)],
              [np.sin(t),  np.cos(t)]])

S = np.array([[1.3, 0],
              [0, 1.3]])

H = np.array([[1, 0.5],
              [0, 1]])

images = [img, transform(R), transform(S), transform(H)]
titles = ["Original", "Rotation", "Scaling", "Shearing"]

for i in range(4):
    plt.subplot(1, 4, i+1)
    plt.imshow(images[i])
    plt.title(titles[i])
    plt.axis("off")

plt.tight_layout()
plt.show()